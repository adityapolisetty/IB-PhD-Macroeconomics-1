---
import SiteLayout from '../layouts/SiteLayout.astro';
import UtilityExplorer from '../components/UtilityExplorer.svelte';
import { withBase } from '../lib/lessons.js';
---

<SiteLayout title="Utility and production functions" description="Overlay common utility functions and AK production, with tangents, derivatives and extrema.">
  <main class="utility-page" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={withBase()}>Course home</a><span aria-hidden="true">/</span><span>Utility and production functions</span></nav>
    <UtilityExplorer client:load />
  </main>
</SiteLayout>

<style>
  .utility-page { max-width: 1450px; margin: 0 auto; padding: 0 40px 90px; }
  .breadcrumbs { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: .78rem; padding: 23px 0 0; }
  .breadcrumbs a { text-decoration: none; }
  @media (max-width: 760px) { .utility-page { padding: 0 22px 65px; } }
</style>
