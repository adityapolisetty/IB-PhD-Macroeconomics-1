---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/lessons.js';
---
<SiteLayout>
  <main class="home" id="main">
    <section class="home-intro">
      <div><p class="eyebrow">Interactive mathematics</p><h1>Macroeconomics 1</h1></div>
      <div class="intro-copy"><p>Explore the shapes behind economic models. Move a tangent, inspect a slope, and see where a function reaches its limits.</p></div>
    </section>
    <section aria-labelledby="directory-title">
      <div class="directory-heading"><h2 id="directory-title">Explore</h2><span>A visual guide</span></div>
      <a class="lesson-row" href={withBase('utility-functions/')}><span class="number">01</span><div><h3>Utility and production functions</h3><p>Overlay utility functions and AK production to compare marginal utility, extrema and constant marginal product.</p></div><span class="topic">Mathematical foundations</span><span class="arrow" aria-hidden="true">↗</span></a>
    </section>
  </main>
</SiteLayout>
