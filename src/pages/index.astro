---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/lessons.js';
---
<SiteLayout>
  <main class="home" id="main">
    <section class="home-intro">
      <div><p class="eyebrow">Interactive mathematics</p><h1>Macroeconomics 1</h1></div>
    </section>
    <section aria-labelledby="directory-title">
      <div class="directory-heading"><h2 id="directory-title">Explore</h2></div>
      <a class="lesson-row" href={withBase('utility-functions/')}><span class="number">01</span><div><h3>Utility functions</h3><p>Log, CRRA, CARA and quadratic utility.</p></div><span class="arrow" aria-hidden="true">↗</span></a>
      <a class="lesson-row" href={withBase('production-functions/')}><span class="number">02</span><div><h3>Production functions</h3><p>AK, Cobb-Douglas and CES production.</p></div><span class="arrow" aria-hidden="true">↗</span></a>
    </section>
  </main>
</SiteLayout>
