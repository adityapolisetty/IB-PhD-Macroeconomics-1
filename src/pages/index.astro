---
import { withBase } from '../lib/lessons.js';
// No separate home page: the site root forwards at once to the first guide page.
const target = withBase('utility-functions/');
const canonical = new URL(target, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Utility functions</title>
  </head>
  <body><a href={target}>Utility functions</a></body>
</html>
