---
import '../styles/global.css';
import { withBase } from '../lib/lessons.js';
interface Props { title?: string; description?: string; }
const courseTitle = 'IB PhD Macroeconomics 1';
const { title = courseTitle, description = 'Interactive models, written intuition and Python tutorials for IB PhD Macroeconomics 1.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title === courseTitle ? title : `${title} · ${courseTitle}`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={withBase()} aria-label="Imperial · Course home"><img class="site-logo" src={withBase('imperial-logo.svg')} alt="Imperial" width="1548" height="170" /></a>
      </div>
    </header>
    <slot />
    <footer class="site-footer"><span>IB PhD Macroeconomics 1 · Tutorial companion</span><span>Aditya Polisetty</span></footer>
  </body>
</html>
